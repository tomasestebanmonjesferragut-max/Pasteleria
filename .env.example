# Copia este archivo a ".env" y completa tus propios valores.
# NUNCA subas el archivo ".env" real a git (ya está en .gitignore).

# Puerto del servidor (los hostings como Render/Railway lo asignan solos)
PORT=3000

# Conexión a MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=cambia_esto
DB_NAME=dulzura_db

# Secreto para firmar los tokens de sesión (JWT).
# Genera uno fuerte y único, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
